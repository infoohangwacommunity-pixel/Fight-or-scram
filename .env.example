# ── Application ──────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── WhatsApp ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WEBHOOK_VERIFY_TOKEN=your_chosen_verify_token_here
WEBHOOK_APP_SECRET=your_app_secret_here

# ── Database ─────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/waxprep

# ── Cache / Queue ────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI ───────────────────────────────────
AI_PROVIDER=groq
AI_API_KEY=your_ai_api_key_here

# ── Security ─────────────────────────────
ENCRYPTION_KEY=a_32_byte_hex_string_here
